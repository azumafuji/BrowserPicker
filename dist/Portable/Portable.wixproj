<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <InstallerPlatform Condition="'$(InstallerPlatform)' == '' and ('$(Platform)' == 'ARM64' or '$(Platform)' == 'arm64')">arm64</InstallerPlatform>
    <InstallerPlatform Condition="'$(InstallerPlatform)' == ''">x64</InstallerPlatform>
    <OutputName Condition="'$(OutputName)' == ''">BrowserPicker-Portable</OutputName>
    <DefineConstants>ProductVersion=$(MsiVersion)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.NetFx.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\BrowserPicker.UI\BrowserPicker.UI.csproj">
      <Name>BrowserPicker.UI</Name>
      <Project>{b875ae86-5212-4f7f-bb1c-2baa1fc110bc}</Project>
      <Private>True</Private>
      <DoNotHarvest>True</DoNotHarvest>
      <RefProjectOutputGroups>Binaries;Content;Satellites</RefProjectOutputGroups>
      <RefTargetDir>INSTALLFOLDER</RefTargetDir>
    </ProjectReference>
  </ItemGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' or '$(Configuration)|$(Platform)' == 'Debug|ARM64' ">
    <DefineConstants>$(DefineConstants);Debug</DefineConstants>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' or '$(Configuration)|$(Platform)' == 'Release|ARM64' ">
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <Target Name="CopyMsiToConfigDir" AfterTargets="Build">
    <Copy
      SourceFiles="$(OutputPath)$(OutputName).msi"
      DestinationFiles="bin\$(Configuration)\$(OutputName).msi"
      Condition="Exists('$(OutputPath)$(OutputName).msi') and '$(OutputPath)' != 'bin\$(Configuration)\'"
      ContinueOnError="true" />
  </Target>
</Project>